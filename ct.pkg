# sql - a dialect-neutral SQL builder (SELECT / INSERT / UPDATE / DELETE).
#
# One mapping unit (`sql/Sql.m.ct`) plus a shim pair
# (`sql/Sql.shim.h` / `sql/Sql.shim.c`). Values are bound, never
# concatenated: `where("id = ?").bindInt(1)` stores `1` in an ordered
# `sql_value` array and renders the text with the `?` untouched.
#
# No `cflags`: the C face is fixed-arity and uses only C99 features.
name = sql
version = 0.2.0
licence = MIT
requires = ct >= 0.20.3
